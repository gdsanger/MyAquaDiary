# Copy to .env and adjust for local development.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=myaquadiary
POSTGRES_USER=myaquadiary
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Basis-URL für absolute Links in Mails.
SITE_URL=http://localhost:8000

# Schlüssel für verschlüsselte Felder (z. B. das Graph-Client-Secret).
# Kommagetrennt; der erste Schlüssel verschlüsselt, weitere erlauben Rotation.
# Ohne Angabe wird ein Schlüssel aus DJANGO_SECRET_KEY abgeleitet — dann macht
# ein Wechsel des Secret Keys gespeicherte Geheimnisse unlesbar.
DJANGO_FIELD_ENCRYPTION_KEYS=

# Microsoft Graph — Startwerte für die Mail-Konfiguration (Client Credentials,
# App-Registrierung mit Application-Permission Mail.Send). Optional: ohne diese
# Werte läuft das System weiter, die Mailfunktionen sind dann inaktiv.
# Über den Admin gepflegte Werte haben Vorrang.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_ADDRESS=
GRAPH_SENDER_NAME=MyAquaDiary
GRAPH_REPLY_TO=
