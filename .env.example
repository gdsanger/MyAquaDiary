# Copy to .env and adjust for local development.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=myaquadiary
POSTGRES_USER=myaquadiary
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Basis-URL für absolute Links in Mails.
SITE_URL=http://localhost:8000

# Schlüssel für verschlüsselte Felder (z. B. das Graph-Client-Secret).
# Kommagetrennt; der erste Schlüssel verschlüsselt, weitere erlauben Rotation.
# Ohne Angabe wird ein Schlüssel aus DJANGO_SECRET_KEY abgeleitet — dann macht
# ein Wechsel des Secret Keys gespeicherte Geheimnisse unlesbar.
DJANGO_FIELD_ENCRYPTION_KEYS=

# Timeout (Sekunden) für Requests an EHEIM-Digital-Geräte im LAN.
EHEIM_TIMEOUT=5

# Timeout (Sekunden) für Requests an Shelly-Steckdosen im LAN.
SHELLY_TIMEOUT=5

# Arbeitspreis je Kilowattstunde (Euro) für die Verbrauchsauswertung.
ENERGY_PRICE_PER_KWH=0.35

# Wie weit ein KH- und ein pH-Wert auseinanderliegen dürfen, damit daraus CO₂
# gerechnet wird. Liegt kein Partnerwert im Fenster, wird kein CO₂ angezeigt.
CO2_PAIR_WINDOW_HOURS=6

# Ablage der Gerätedokumente (Anleitungen, Rechnungen). Bewusst außerhalb von
# mediafiles: was dort liegt, wird ausgeliefert, sobald jemand die Adresse
# kennt. Diese Dateien gehen nur über eine Ansicht mit Eigentümerprüfung raus.
DJANGO_PRIVATE_MEDIA_ROOT=

# Interner nginx-Ort für X-Accel-Redirect (z. B. /geschuetzt/). Leer heißt:
# Django liefert die Datei selbst aus — in der Entwicklung genau richtig.
DJANGO_PRIVATE_MEDIA_ACCEL_LOCATION=

# Größte zulässige Datei je Gerätedokument (Bytes).
DEVICE_DOCUMENT_MAX_BYTES=10485760

# Anthropic Claude — Startwerte für die KI-Konfiguration. Optional: ohne Key
# läuft das System weiter, die KI-Funktionen sind dann ausgeblendet.
# Über den Admin gepflegte Werte haben Vorrang.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Längste Bildkante (px), auf die Fotos vor dem Versand gerechnet werden.
AI_IMAGE_MAX_EDGE=1024

# Timeout (Sekunden) für einen Aufruf der Claude-API.
AI_TIMEOUT=120

# Microsoft Graph — Startwerte für die Mail-Konfiguration (Client Credentials,
# App-Registrierung mit Application-Permission Mail.Send). Optional: ohne diese
# Werte läuft das System weiter, die Mailfunktionen sind dann inaktiv.
# Über den Admin gepflegte Werte haben Vorrang.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_ADDRESS=
GRAPH_SENDER_NAME=MyAquaDiary
GRAPH_REPLY_TO=

# MCP-Server (Streamable HTTP für externe KI-Clients). Tokens werden in der
# Anwendung unter „MCP-Zugänge“ angelegt, nicht hier. MCP_PUBLIC_URL ist die
# Adresse, unter der Clients den eigenen Dienst erreichen — sie steht mit dem
# Token auf der Token-Seite.
MCP_PUBLIC_URL=http://localhost:8001
MCP_RATE_LIMIT_PER_MINUTE=60
# Herkünfte, die den Endpunkt aus einem Browser ansprechen dürfen (leer =
# keine). Ein fehlender Origin-Header ist zulässig — native Clients senden
# keinen. Die Prüfung richtet sich gegen DNS-Rebinding.
MCP_ALLOWED_ORIGINS=
# Vorbelegte Laufzeit eines neuen Zugangs in Tagen.
MCP_TOKEN_DEFAULT_DAYS=90
# Der alte SSE-Transport (/mcp/sse/, /mcp/messages/). Auf False läuft der
# Dienst zustandslos und darf mehrere Worker haben.
MCP_LEGACY_SSE=True
MCP_LEGACY_SUNSET=2026-12-31
MCP_KEEPALIVE_SECONDS=15
MCP_SESSION_IDLE_TIMEOUT=3600
